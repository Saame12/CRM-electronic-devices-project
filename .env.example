# Copy to .env, or run npm run config to generate a local file with a random JWT_SECRET.
# Fill in the MySQL account on YOUR computer. Never commit .env or .env.demo.
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=backline_crm
DB_USER=root
DB_PASSWORD=your_MySQL_pass
JWT_SECRET=replace_with_a_long_random_secret
