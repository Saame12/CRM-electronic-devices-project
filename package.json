    "setup": "node scripts/setup-project.js",
    "setup:check": "node scripts/check-installation-db.js",
    "format:staff": "prettier --write admin.js role-ui.js staff-*.js reports.js recovery-admin.js public-assets.js admin.css admin.html manager.html",
    "check:staff": "prettier --check admin.js role-ui.js staff-*.js reports.js recovery-admin.js public-assets.js admin.css admin.html manager.html",
    "test:reports": "node --test scripts/reports.test.js",
    "db:setup": "node scripts/setup-database.js",
    "demo:setup": "node scripts/setup-demo.js",
    "demo:start": "node scripts/start-demo.js",
    "demo:check": "node scripts/check-demo.js",
    "db:backup": "node scripts/database-backup.js backup",
    "db:restore": "node scripts/database-backup.js restore",
    "db:migrate": "node scripts/migrate-crm.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
